# Copie este arquivo para ".env" e ajuste. O ".env" NÃO deve ser enviado ao GitHub.

# --- Modo de execução ---------------------------------------------------------
# Local: True. Produção: False (padrão se a variável não existir).
DEBUG=True

# --- Segurança ----------------------------------------------------------------
# Obrigatória quando DEBUG=False. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=
# Domínios permitidos, separados por vírgula (em produção, o do provedor/seu domínio).
ALLOWED_HOSTS=localhost,127.0.0.1
# Caminho do painel admin do Django (troque para algo menos previsível).
ADMIN_URL=painel-admin/
# Origens do front-end autorizadas a chamar a API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Atrás de proxy/provedor: quantidade de proxies (Render = 1). Deixe vazio localmente.
# NUM_PROXIES=1

# --- Banco de dados -----------------------------------------------------------
# Vazio = SQLite local (db.sqlite3). Produção: PostgreSQL, por exemplo
# DATABASE_URL=postgres://usuario:senha@host:5432/camilalee

# --- Administrador inicial (python manage.py criar_admin) ---------------------
# ADMIN_EMAIL=camila@email.com
# ADMIN_SENHA=defina-uma-senha-forte
# ADMIN_NOME=Camila Lee
# ADMIN_TELEFONE=61999999999

# --- E-mail (recuperação de senha) --------------------------------------------
# Sem EMAIL_HOST, o e-mail (com o código) é impresso no terminal.
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Camila Lee <contato@exemplo.com>

# --- Opcionais ----------------------------------------------------------------
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=1
# CODIGO_REDEFINICAO_MINUTOS=15
# LOG_LEVEL=INFO
